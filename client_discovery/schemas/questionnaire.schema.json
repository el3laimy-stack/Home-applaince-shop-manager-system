{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alikhlas:discovery:questionnaire:1",
  "title": "تعريف الأسئلة المستقرة",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "sections",
    "questions",
    "priorityOptions",
    "timelineOptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "alikhlas-client-discovery"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description"
        ]
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "section",
          "type",
          "required",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.-]{1,80}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          },
          "type": {
            "enum": [
              "single",
              "multi",
              "text",
              "rating",
              "pain",
              "timeline",
              "priorities",
              "access"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "$ref": "#/$defs/condition"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/option"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "priorityOptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "timelineOptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "condition": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "question",
            "op",
            "value"
          ],
          "properties": {
            "question": {
              "type": "string"
            },
            "op": {
              "enum": [
                "eq",
                "neq",
                "contains",
                "in",
                "timelineContains"
              ]
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "required": [
            "derived"
          ],
          "properties": {
            "derived": {
              "const": "hasNeeds"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "repeat"
          ],
          "properties": {
            "repeat": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "option": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "legacyOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
